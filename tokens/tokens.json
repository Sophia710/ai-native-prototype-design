{
  "schema_version": "1.0.0",
  "description": "AI 原生原型设计 — 唯一视觉权威。所有颜色提供 light/dark 两套值；间距、圆角、动效、字体、排版为跨主题常量。组件只允许引用 --ds-* 变量，禁止裸值。",
  "naming": "JSON key 直接映射 CSS 变量：key -> --ds-{key}。例如 text-primary -> --ds-text-primary。",
  "contrast": {
    "rule": "正文/控件文字与背景对比度 ≥ 4.5:1；tertiary/quaternary 仅用于元信息、禁用、基线等非正文。",
    "light": {
      "text-secondary": "≈7.6:1 on surface",
      "text-tertiary": "≈4.5:1 on surface"
    },
    "dark": {
      "text-secondary": "≈8.7:1 on surface",
      "text-tertiary": "≈5.2:1 on surface"
    }
  },
  "groups": {
    "color": {
      "text-primary": {
        "role": "主文字、关键数值、深色主控件底色、高强调图标、选中/激活态、focus ring",
        "used_by": ["button--primary", "message-bubble--user", "history-tree 选中行", "conversation-header", "所有主文字"],
        "light": "#1F1F1F",
        "dark": "#F5F5F5"
      },
      "text-secondary": {
        "role": "次级说明文字、非激活导航项",
        "used_by": ["message-actions", "artifact-card 元信息", "citation-chip"],
        "light": "#595959",
        "dark": "#B8B8B8"
      },
      "text-tertiary": {
        "role": "元信息、时间、占位符、低强调图标",
        "used_by": ["history-tree 分组标题", "step-timeline 耗时", "composer placeholder"],
        "light": "#787878",
        "dark": "#8C8C8C"
      },
      "text-quaternary": {
        "role": "禁用文字/控件、图表基线与网格线、'无数据'标记",
        "used_by": ["disabled 控件", "code-block 基线", "document-preview 空态"],
        "light": "#B3B3B3",
        "dark": "#595959"
      },
      "on-primary": {
        "role": "深色主控件上的文字/图标",
        "used_by": ["button--primary 文字", "message-bubble--user 文字", "icon-button 深色底"],
        "light": "#FFFFFF",
        "dark": "#1A1A1A"
      },
      "surface": {
        "role": "页面/body 基色（仅此一处定义页面基色，组件内部不再设置基色）",
        "used_by": ["body（tokens.css 单点）", "workbench-shell"],
        "light": "#FFFFFF",
        "dark": "#1A1A1A"
      },
      "surface-muted": {
        "role": "次级表面：悬停浅底、输入框底、chip 底",
        "used_by": ["composer", "history-tree hover", "attachment-chip", "file-tree 选中行"],
        "light": "#F7F7F7",
        "dark": "#222222"
      },
      "surface-raised": {
        "role": "抬升表面：浮层、弹窗、下拉、页签弹层",
        "used_by": ["popover-menu", "dialog-confirm", "mention-popover", "model-switcher"],
        "light": "#FFFFFF",
        "dark": "#242424"
      },
      "surface-strong": {
        "role": "更强区分表面：工具栏、面板头、拖拽手柄",
        "used_by": ["artifact-toolbar", "artifact-panel 页签行", "file-tree 头部"],
        "light": "#F0F0F0",
        "dark": "#2E2E2E"
      },
      "border": {
        "role": "默认细边框（0.5–1px）",
        "used_by": ["composer", "artifact-panel", "分隔结构", "输入控件"],
        "light": "#E5E5E5",
        "dark": "rgba(255,255,255,0.12)"
      },
      "border-strong": {
        "role": "需要加强的边框：激活输入、拖拽手柄 hover",
        "used_by": ["composer:focus-within", "壳层分隔强调"],
        "light": "#D4D4D4",
        "dark": "rgba(255,255,255,0.20)"
      },
      "divider": {
        "role": "分隔线，弱于 border",
        "used_by": ["消息之间", "工具栏分隔", "页签分隔"],
        "light": "#EBEBEB",
        "dark": "rgba(255,255,255,0.08)"
      },
      "hover-fill": {
        "role": "交互元素 hover 中性浅底（灰阶，非蓝色）",
        "used_by": ["button--secondary:hover", "菜单项 hover", "列表行 hover"],
        "light": "rgba(0,0,0,0.04)",
        "dark": "rgba(255,255,255,0.06)"
      },
      "active-fill": {
        "role": "交互元素按下/选中中性底",
        "used_by": ["button--secondary:active", "菜单选中", "chip 选中"],
        "light": "rgba(0,0,0,0.08)",
        "dark": "rgba(255,255,255,0.10)"
      },
      "scrim": {
        "role": "弹窗遮罩",
        "used_by": ["dialog-confirm 背景"],
        "light": "rgba(0,0,0,0.45)",
        "dark": "rgba(0,0,0,0.60)"
      },
      "danger": {
        "role": "危险/错误语义（删除、报错）。仅语义使用，不作交互强调",
        "used_by": ["button--danger", "dialog-confirm 危险项", "删除菜单"],
        "light": "#DC2626",
        "dark": "#F26D6D"
      },
      "on-danger": {
        "role": "实色危险按钮上的文字",
        "used_by": ["button--danger 文字"],
        "light": "#FFFFFF",
        "dark": "#1A1A1A"
      },
      "positive": {
        "role": "成功/完成语义",
        "used_by": ["step-timeline done", "status--positive", "同步完成"],
        "light": "#16A34A",
        "dark": "#4CC38A"
      },
      "warning": {
        "role": "警告/进行中注意语义",
        "used_by": ["status--warning", "step-timeline running"],
        "light": "#B45309",
        "dark": "#F5B544"
      },
      "accent": {
        "role": "强调蓝：仅数据可视化与真实语义强调；绝不用作'可交互'、页面底色或主填充",
        "used_by": ["citation 激活角标", "图表外的少量语义强调"],
        "light": "#2563EB",
        "dark": "#60A5FA"
      },
      "on-accent": {
        "role": "accent 实色标记上的文字",
        "used_by": ["accent 填充的 chip/badge"],
        "light": "#FFFFFF",
        "dark": "#0B1B33"
      },
      "chart-1": {
        "role": "分类系列第 1 色（蓝）；默认顺序使用",
        "used_by": ["chart"],
        "light": "#2563EB",
        "dark": "#60A5FA"
      },
      "chart-2": {
        "role": "分类系列第 2 色（红）；禁止与 chart-3 在同一图表配对（色盲安全）",
        "used_by": ["chart"],
        "light": "#DC2626",
        "dark": "#F87171"
      },
      "chart-3": {
        "role": "分类系列第 3 色（绿）；禁止与 chart-2 在同一图表配对",
        "used_by": ["chart"],
        "light": "#16A34A",
        "dark": "#4ADE80"
      },
      "chart-4": {
        "role": "分类系列第 4 色（紫）",
        "used_by": ["chart"],
        "light": "#7C3AED",
        "dark": "#A78BFA"
      },
      "chart-5": {
        "role": "分类系列第 5 色（中性灰）；超过 5 系列后改用线型区分，不再加色",
        "used_by": ["chart"],
        "light": "#8C8C8C",
        "dark": "#8C8C8C"
      }
    },
    "space": {
      "_comment": "唯一间距阶（px）。任何间距只能取这 7 个值。",
      "space-1": { "value": 4, "unit": "px", "role": "紧凑内联间隙、图标与文字" },
      "space-2": { "value": 8, "unit": "px", "role": "控件内边距、紧凑行间隙" },
      "space-3": { "value": 12, "unit": "px", "role": "列表项间距、卡片内边距" },
      "space-4": { "value": 16, "unit": "px", "role": "标准内边距、区块间隙（默认值）" },
      "space-5": { "value": 20, "unit": "px", "role": "宽松区块间隙" },
      "space-6": { "value": 24, "unit": "px", "role": "面板/消息间距" },
      "space-7": { "value": 32, "unit": "px", "role": "大区域分隔" }
    },
    "radius": {
      "_comment": "唯一圆角阶。嵌套圆角遵循 inner = outer − padding，内小外大、同心。",
      "radius-small": { "value": 4, "unit": "px", "role": "面板内子元素（12px 面板 − 8px 内边距）" },
      "radius-chip": { "value": 6, "unit": "px", "role": "chip、标签" },
      "radius-button": { "value": 8, "unit": "px", "role": "按钮、图标按钮" },
      "radius-input": { "value": 10, "unit": "px", "role": "输入框、列表卡片" },
      "radius-panel": { "value": 12, "unit": "px", "role": "抬升面板、弹窗" },
      "radius-large": { "value": 16, "unit": "px", "role": "大型容器（少用）" },
      "radius-full": { "value": 9999, "unit": "px", "role": "胶囊、头像、圆形按钮" }
    },
    "motion": {
      "t-micro": { "value": "80ms", "role": "按压、开关等瞬时反馈" },
      "t-fast": { "value": "120ms", "role": "hover、行操作显露" },
      "t-normal": { "value": "200ms", "role": "面板展收、浮层进出（默认）" },
      "t-slow": { "value": "300ms", "role": "栏位宽展收" },
      "t-spin": { "value": "1s", "role": "步骤进行中旋转指示（1 圈/秒，linear 匀速；reduced-motion 静止脉冲）" },
      "ease-out": { "value": "cubic-bezier(0.16,1,0.3,1)", "role": "进入" },
      "ease-in": { "value": "cubic-bezier(0.7,0,0.84,0)", "role": "退出" },
      "ease-standard": { "value": "cubic-bezier(0.4,0,0.2,1)", "role": "通用、拖拽" }
    },
    "font": {
      "font-sans": {
        "value": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Helvetica Neue\", Arial, sans-serif",
        "role": "唯一 UI 字体；系统字体栈，离线可用，禁止在组件内另写字体栈"
      },
      "font-mono": {
        "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace",
        "role": "仅代码、哈希、原始标识符、日志；禁止用于大数字/计时/价格"
      },
      "font-serif": {
        "value": "Georgia, \"Songti SC\", \"SimSun\", serif",
        "role": "编辑性衬线，极少使用，禁止用于 UI chrome"
      }
    },
    "typography": {
      "_comment": "正文基准 16px/24px 由 tokens.css 在 body 设置。只有 400/500 两档字重。",
      "fs-caption": { "value": "12px", "lh": "18px", "role": "元信息、紧凑标签" },
      "fs-compact": { "value": "14px", "lh": "22px", "role": "次级文字、密集表格" },
      "fs-body": { "value": "16px", "lh": "24px", "role": "正文基准" },
      "fs-title": { "value": "17px", "lh": "26px", "role": "区块标题" },
      "fs-page": { "value": "20px", "lh": "28px", "role": "页面/会话标题" },
      "fs-display": { "value": "32px", "lh": "1.2", "role": "欢迎页主问候；紧凑表面内最大不超过 48px" },
      "weight-regular": { "value": 400, "role": "常规" },
      "weight-medium": { "value": 500, "role": "加粗（最高字重，禁止 600/700）" }
    },
    "shadow": {
      "_comment": "仅用于抬升表面；保持轻、平，禁止重阴影/模糊/玻璃拟态。",
      "shadow-raised": {
        "light": "0 1px 2px rgba(0,0,0,0.06), 0 4px 16px rgba(0,0,0,0.06)",
        "dark": "0 1px 2px rgba(0,0,0,0.4), 0 4px 16px rgba(0,0,0,0.4)",
        "role": "浮层、菜单、下拉、弹窗"
      },
      "focus-ring": {
        "light": "0 0 0 2px rgba(31,31,31,0.35)",
        "dark": "0 0 0 2px rgba(245,245,245,0.45)",
        "role": "键盘焦点环（深色，不用蓝）"
      }
    },
    "layout": {
      "_comment": "chat-workbench 壳层几何常量（跨主题）。",
      "left-width": { "value": 260, "unit": "px", "min": 240, "max": 320, "role": "左栏默认/可调区间" },
      "right-width": { "value": 480, "unit": "px", "min": 320, "max": 720, "role": "右栏默认/可调区间" },
      "center-min": { "value": 360, "unit": "px", "role": "中栏最小宽度，触底后右栏不再增宽" },
      "touch-target": { "value": 44, "unit": "px", "role": "触控目标最小边长" }
    }
  }
}
